# Application
NODE_ENV=development
PORT=3000
# Public trace + QR codes use this origin (must be reachable from the phone when testing scans).
FRONTEND_URL=http://localhost:4200

# Packaging PDF labels + public branding (GET .../public/branding, PDF labels).
# LABEL_BRAND_NAME drives: landing toolbar = brand only; platform UI = "${BRAND} Supply Tracking".
# LABEL_LOGO_URL=   # Supports PNG/JPG/SVG URL or local file path. On fetch failure, src/assets/marea-alta-logo.png is used.
# LABEL_BRAND_NAME=MAREA ALTA

# Retail label (Ecuador normative) — maquila / owner legal lines
# LABEL_OWNER_RUC=
# LABEL_OWNER_LEGAL_NAME=MAREA ALTA
# LABEL_OWNER_LOCATION=Portoviejo - Manabí - Ecuador
# LABEL_ARCSA_NOTIFICATION=En trámite

# Fallback for products without per-SKU retail fields (after migration)
# LABEL_DEFAULT_GTIN13=5931234567890
# LABEL_DEFAULT_NET_WEIGHT_OZ=32
# LABEL_DEFAULT_NET_WEIGHT_LBS=2
# LABEL_DEFAULT_TITLE=Camarón Premium

# Optional: override landing toolbar text only (e.g. MAREA ALTA). When unset, uses LABEL_BRAND_NAME uppercased.
# PUBLIC_LANDING_TITLE=

# Legacy: override landing toolbar if PUBLIC_LANDING_TITLE is unset. Prefer PUBLIC_LANDING_TITLE.
# PUBLIC_HEADER_TITLE=

# Landing footer: "Developed by BITFLOW" (logo replaces site URL in UI/PDF)
# BITFLOW_LOGO_URL=  # empty → bundled api/src/assets/bitflow-logo.png
# BITFLOW_SITE_URL=https://bitflow.bid
# CONTACT_EMAIL=info@bitflow.bid

# CORS: comma-separated allowed origins. If unset in development, all origins are reflected (origin: true).
# In production, either set CORS_ORIGIN or rely on FRONTEND_URL as the single allowed origin.
# CORS_ORIGIN=https://app.example.com,https://staging.example.com

# Database (Docker postgres — `docker compose up -d` in api/)
DATABASE_URL="postgresql://user:password@localhost:5432/supply_tracking?schema=public"

# ChromaDB vector store (separate Docker service on port 8000)
# CHROMA_URL=http://localhost:8000
# CHROMA_COLLECTION=marea_recipe_chunks

# OpenAI — Mary chatbot RAG (optional in dev; chat returns graceful fallback without key)
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Optional recipe ingest APIs
# SPOONACULAR_API_KEY=

# JWT (required in production; must not be the dev placeholder)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# AWS S3 — marketplace product images (optional in dev; falls back to local uploads/)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=marea-alta
# S3_PUBLIC_BASE_URL=https://marea-alta.s3.us-east-1.amazonaws.com

# SMTP — marketplace order notification emails (optional in dev; order stays PENDING)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@mareaalta.com
